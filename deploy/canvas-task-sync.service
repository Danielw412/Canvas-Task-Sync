[Unit]
Description=Canvas Task Sync backend and dashboards
Documentation=https://github.com/Danielw412/Canvas-Task-Sync
# No network ordering: the sockets it binds are loopback, and every outbound call happens
# later, on demand. network-online.target does not exist in a user manager anyway.

[Service]
Type=simple
WorkingDirectory=%h/projects/Canvas-Task-Sync
# One process and one event loop serve both dashboards, loopback only:
#   127.0.0.1:8790  API + full dashboard (School Dashboard's own tunnel also targets this)
#   127.0.0.1:8891  simple dashboard
# A laptop reaches both at its usual addresses with:
#   ssh -N -L 127.0.0.1:8890:127.0.0.1:8790 -L 127.0.0.1:8891:127.0.0.1:8891 daniel@<server>
ExecStart=%h/projects/Canvas-Task-Sync/.venv/bin/python -m canvas_task_sync \
    --config config/courses.yaml \
    web --port 8790 --simple-port 8891 --no-open
# The address browsers type. It arrives through the tunnel as Host and Origin, the
# simple dashboard calls the API there, and Google returns there after consent. The
# service never opens a browser itself.
Environment=CANVAS_TASK_SYNC_PUBLIC_ORIGIN=http://127.0.0.1:8890
Environment=PYTHONUNBUFFERED=1

# --- Idle footprint -----------------------------------------------------------------
# glibc gives each thread its own malloc arena and never returns them, so the sync
# worker pool alone was costing tens of megabytes of fragmentation that outlived every
# run. One arena is plenty for work that spends its time waiting on Canvas, Gemini,
# and Google Tasks rather than on the allocator; the lock contention it costs is not
# measurable for I/O-bound work.
Environment=MALLOC_ARENA_MAX=1
# Return freed heap to the OS at 128 KiB instead of hoarding it, and keep the mmap
# threshold from growing dynamically so large short-lived buffers (page captures,
# base64 screenshots, whole task lists) are unmapped on free rather than retained.
Environment=MALLOC_TRIM_THRESHOLD_=131072
Environment=MALLOC_MMAP_THRESHOLD_=131072

# A runaway guard, not a working limit: normal operation sits far below this.
MemoryMax=1G

Restart=on-failure
RestartSec=5
TimeoutStopSec=30

# The service only ever needs its own project directory.
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=full

[Install]
WantedBy=default.target
